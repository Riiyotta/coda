      "routes": [
        "/"
      ],
      "traits": "two-span h1, 2 buttons (grey+black), 6-logo marquee, InlineVideo"
    },
    "product-image": {
      "routes": [
        "/product/codapay/",
        "/product/coda-links/",
        "/product/distribution/"
      ],
      "traits": "icon+wordmark, 1-2 buttons, 5 logos, image (desktop 2.22 ratio)"
    },
