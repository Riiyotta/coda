{
  "id": "shell.navbar",
  "kind": "section",
  "category": "shell",
  "content": {
    "type": "object",
    "required": [
      "categories",
      "pricingLabel",
      "loginLabel",
      "ctaLabel",
      "languageLabel"
    ],
    "properties": {
      "categories": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 1,
              "note": "Products / Solutions / Resources / Company"
            },
            "links": {
              "type": "array",
              "minItems": 4,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "maxWords": 4
                  },
                  "href": {
                    "type": "string",
                    "note": "one of the 15 routes or \"#\" (inert)",
                    "format": "route-or-inert-hash"
                  },
                  "description": {
                    "type": "string",
                    "maxWords": 7
                  }
                },
                "required": [
                  "label",
                  "href"
                ]
              },
              "note": "Measured link counts: Products 6 (label + description), Solutions 8 (label only), Resources 6, Company 5"
            },
            "featured": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "maxWords": 2
                },
                "subtitle": {
                  "type": "string",
                  "maxWords": 4
                }
              },
              "required": [
                "title"
              ],
              "note": "Resources (\"Case Studies\" tile) and Company (\"Contact Us\" tile) only"
            }
          },
          "required": [
            "label",
            "links"
          ]
        },
        "note": "Exactly four dropdowns, in this order."
      },
      "pricingLabel": {
        "type": "string",
        "maxWords": 1,
        "note": "Direct link to /pricing/"
      },
      "loginLabel": {
        "type": "string",
        "maxWords": 1
      },
      "ctaLabel": {
        "type": "string",
        "maxWords": 2,
        "note": "\"Get started\""
      },
      "languageLabel": {
        "type": "string",
        "maxWords": 1,
        "note": "\"EN\" - not functional in the clone (spec section 1c)"
      },
      "logo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetRole": {
            "type": "string",
            "enum": [
              "coda-wordmark"
            ]
          }
        },
        "required": [
          "assetRole"
        ],
        "note": "fixed Coda wordmark svg; must-reuse-exact"
      }
    },
    "additionalProperties": false,
    "maxWordsTotal": 385
  },
  "usedOn": [
