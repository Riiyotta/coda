{
  "id": "callout.feature",
  "kind": "section",
  "category": "callout",
  "content": {
    "type": "object",
    "properties": {
      "icon": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "glyph": {
            "type": "string",
            "enum": [
              "inline-svg-glyph"
            ]
          },
          "wordmark": {
            "type": "string",
            "enum": [
              "inline-svg-wordmark"
            ]
          },
          "tint": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "pink",
              "yellow",
              "purple",
              "orange"
            ]
          }
        },
        "required": [
          "glyph"
        ]
      },
      "heading": {
        "type": "string",
        "maxWords": 8,
        "note": "product-titled variant only; measured 2-8 words"
      },
      "body": {
        "type": "string",
        "maxWords": 60,
        "bodyCopy": true,
        "note": "BODY COPY. Measured 10-25 words (industry/product), 31-43 (giftcloud, distribution), up to 60 words per panel on consumer-platforms (b real copy). Budget 60."
      },
      "extraLines": {
        "type": "array",
        "minItems": 0,
        "maxItems": 3,
        "items": {
          "type": "string",
          "maxWords": 5
        },
        "note": "distribution second callout only: three short lines (5,5,3 words)"
      },
      "link": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxWords": 2
          },
          "href": {
            "type": "string",
            "format": "route-or-inert-hash"
          }
        },
        "required": [
          "label"
        ],
        "note": "\"Learn more\" text link (industry variant, measured 2 words)"
      },
      "media": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetRole": {
            "type": "string",
            "enum": [
              "section-product-mockup"
            ]
          },
          "assetRef": {
            "type": "string",
            "format": "local-asset-path"
          }
        },
        "required": [
          "assetRole",
          "assetRef"
        ]
      },
      "panels": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assetRole": {
                  "type": "string",
                  "enum": [
                    "section-product-mockup"
                  ]
                },
                "assetRef": {
                  "type": "string",
                  "format": "local-asset-path"
                }
              },
              "required": [
                "assetRole",
                "assetRef"
              ]
            },
            "wordmark": {
              "type": "string",
              "enum": [
                "inline-svg-wordmark"
              ]
            },
            "body": {
              "type": "string",
              "maxWords": 60,
              "bodyCopy": true
            }
          },
          "required": [
            "media",
            "wordmark",
            "body"
          ]
        },
        "note": "dual-panel variant only (consumer-platforms)"
      },
      "mediaSide": {
        "type": "string",
        "enum": [
          "left",
          "right"
        ],
        "note": "derived from position in the run: 1st,3rd,5th = left; 2nd,4th = right (desktop only; mobile always media-first)"
      }
    },
    "oneOf": [
      {
        "required": [
          "body",
          "media"
        ]
      },
      {
        "required": [
          "panels"
        ]
      }
    ],
    "additionalProperties": false,
    "maxWordsTotal": 205
  },
