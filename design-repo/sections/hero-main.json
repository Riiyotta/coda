      "routes": [
        "/industries/creator-economy-payments/",
        "/industries/dating-app-payments/",
        "/industries/digital-entertainment/",
        "/industries/esim-digital-utility-payments/",
        "/industries/learning-management-system-payments/",
        "/industries/online-gaming-payments/",
        "/use-case/merchant-of-record/"
      ],
      "traits": "no icons, one black button, 5 logos, image; MoR uses the two-span hero-title"
    },
    "product-video": {
      "routes": [
        "/product/coda-webstore/"
      ],
      "traits": "icon+wordmark, hero-title two-span h1, 4-word button, 5 logos, promo video with toggle"
    },
    "product-marquee": {
      "routes": [
        "/product/coda-consumer-platforms/"
      ],
      "traits": "glyph + 2 wordmarks, one button, 5 logos, phone-shot marquee panel over desktop/mobile background"
    },
    "minimal-icon": {
      "routes": [
        "/product/coda-giftcloud/"
      ],
      "traits": "glyph, h1, p, wide image only (no buttons, no logos)"
    },
    "text-only": {
      "routes": [
        "/pricing/"
      ],
      "traits": "h1 + one line only"
    }
  },
  "constraints": {
    "onePerPage": true,
    "maxPerPage": 1,
    "mustBeFirst": true,
    "mustFollowNav": true,
    "noConsecutive": true,
    "verification": "Checked against all 15 real sequences: hero is the first section on every route (src/components/Main.jsx and every src/pages/*.jsx)."
