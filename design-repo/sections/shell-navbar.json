  "purpose": "Fixed site header: wordmark, four hover-dropdown categories (Products, Solutions, Resources, Company), Pricing link, EN button, Login and Get started; collapses to a hamburger menu below 800px. Shared chrome, rendered outside the page root on every route.",
  "bodyCopyFields": [],
  "variants": {
    "desktop": {
      "from": "800px",
      "traits": "hover dropdowns, right-side actions (EN, Login, Get started), fixed height navBarHeightBase"
    },
    "mobile": {
      "below": "800px",
      "traits": "hamburger toggle; Get started visible in the bar; full-height panel with stacked categories; Login/Get started repeated in the panel"
    }
  },
  "constraints": {
    "onePerPage": true,
    "maxPerPage": 1,
    "mustBeFirst": true,
    "verification": "Rendered once by the app shell before every route (src/App.jsx wraps all 15 routes in Header + Footer); it is not part of any page JSX, so PageSpec nodes list it first."
  },
  "media": {
    "wordmark": {
      "assetRole": [
        "coda-wordmark"
      ],
      "policy": "must-reuse-exact"
    }
  },
  "motion": {
    "pattern": "scroll-hide + gsap-dropdown",
    "interaction": {
      "scrollHide": {
        "threshold": "motion.header.hide-threshold-vh",
        "slide": "motion.header.slide-duration",
        "rule": "hide when y > 0.2*viewport and scrolling down; show on scroll up"
      },
      "dropdownOpen": {
        "panel": "0.5s power2.inOut",
        "items": "0.35s power2.out, stagger 30ms (motion.nav.item-stagger), delay 0.2s",
        "featured": "0.35s, delay 0.4s"
      },
      "dropdownClose": "panel 0.5s, items 0.35s after 0.35s delay",
      "hoverCloseDelay": "300ms",
      "backdrop": "motion.header.dim-duration (700ms)",
      "burger": "three lines rotate/translate to a cross",
      "navigate": "menu closes and header reappears on route change"
    },
    "reducedMotionFallback": "Show the header permanently (no hide-on-scroll) and open/close dropdowns instantly with no GSAP tweens; keep the backdrop static.",
    "reducedMotionFallbackKind": "design-rule (the site ships no prefers-reduced-motion handling, so this is prescribed, not mirrored)"
  },
  "responsive": {
    "breakpoint": "800px (MOBILE_BP)",
    "desktop": "hover-opened dropdown panels; actions on the right; header inset px-5 py-4",
    "mobile": "p-3 inset, wordmark left, EN + Get started + hamburger on the right; tapped categories open a full-height panel (h-[100dvh]); dropdown items stack in one column",
    "resize": "crossing 800px clears hover state"
  },
  "tokens": [
    "component.header.logo-width",
    "component.header.height",
    "component.header.layer",
    "component.header.slide-duration",
    "layout.nav.bar-height",
    "layout.nav.inner-top",
    "elevation.z-header",
    "elevation.blur-dim",
    "icon-size.header-logo",
    "icon-size.nav-toggle-w",
    "icon-size.nav-toggle-h",
    "icon-size.nav-toggle-line-h",
    "type.ui-nav-l",
    "nav.link",
    "motion.header.hide-threshold-vh",
    "motion.header.slide-duration",
    "motion.header.dim-duration",
    "motion.nav.open-duration",
    "motion.nav.item-stagger",
    "radius.lg",
    "radius.mdu"
  ],
  "composes": [
    "primitive.button"
  ],
