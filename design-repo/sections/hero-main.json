  "motion": {
    "pattern": "reveal-cascade",
    "reveals": [
      {
        "element": "hero root",
        "slide": false,
        "duration": "motion.reveal.duration"
      },
      {
        "element": "hero-title / block-p / inline-buttons / publisher-logos",
        "slide": false,
        "duration": "motion.reveal.duration"
      },
      {
        "element": "inline-media",
        "slide": true,
        "offset": "motion.reveal.slide-offset"
      },
      {
        "element": "icon slot 1 (wordmark)",
        "delayMs": 50
      }
    ],
    "revealMechanics": "src/lib/reveal.js swaps opacity-0/translate-y-7 for opacity-100/translate-y-0 at IntersectionObserver threshold 0.1, once",
    "marquee": {
      "speed": "motion.marquee.speed",
      "playRule": "always on <800px or when logos>4; gradient edge only >=800px"
    },
    "video": "autoplay muted loop; toggle button swaps icon instantly",
    "reducedMotionFallback": "Show all hero children at final state with no slide; freeze the logo marquee (paused) and start the hero video paused on its first frame with the toggle available.",
    "reducedMotionFallbackKind": "design-rule (the site ships no prefers-reduced-motion handling, so this is prescribed, not mirrored)"
  },
  "responsive": {
    "breakpoint": "800px (md)",
    "h1": "type-header-3-xl below 800px -> type-header-4-xl from 800px; hero-title variants swap line breaks via hidden md:inline / md:hidden spans",
    "trustRow": "column (label above marquee) below 800px, row from 800px (md:flex-row); marquee always plays on mobile",
    "media": "mobile/desktop item pair on codapay-style pages (aspect 0.976 vs 2.22); consumer-platforms swaps 360/450 mobile background for 1280/576 desktop",
    "buttons": "stay in one nowrap row at all widths"
  },
