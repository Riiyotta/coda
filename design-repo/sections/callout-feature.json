  "motion": {
    "pattern": "reveal-slide",
    "reveals": [
      {
        "element": "section root"
      },
      {
        "element": "inline-media",
        "slide": true,
        "offset": "motion.reveal.slide-offset"
      },
      {
        "element": "wordmark icon",
        "delayMs": 50
      }
    ],
    "interaction": {
      "linkHover": "text-link arrow grows 0 -> 1.2em over 300ms"
    },
    "reducedMotionFallback": "Show text and media at final state; no slide; arrow shown statically.",
    "reducedMotionFallbackKind": "design-rule (the site ships no prefers-reduced-motion handling, so this is prescribed, not mirrored)"
  },
  "responsive": {
    "breakpoint": "800px",
    "grid": "1 col below 800px (media first, then text), 2 cols with gap-10 from 800px",
    "alternation": "from 800px media side alternates: odd left / even right via md:order-first / md:order-last on .inline-media-item and .feature-callout-inner",
    "mediaAspect": "forced 488/500 on both breakpoints"
  },
