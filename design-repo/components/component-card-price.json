{
  "id": "component.card-price",
  "kind": "component",
  "purpose": "Two-tier pricing panel: a themed card with a title, one or two rate columns (icon row, lead-in text, big % figure, unit line), a dashed-divider lower area (rate or checklist) and a button.",
  "props": {
    "additionalProperties": false,
    "required": [
      "tier",
      "title"
    ],
    "properties": {
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "custom"
        ]
      },
      "title": {
        "type": "string",
        "maxWords": 2,
        "note": "Measured: \"Standard pricing\", \"Custom pricing\"."
      },
      "columns": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "figure",
            "unit"
          ],
          "properties": {
            "leadIn": {
              "type": "string",
              "maxWords": 3,
              "note": "\"starts from\", \"flat rate of\"."
            },
            "figure": {
              "type": "string",
              "maxWords": 1,
              "note": "\"1%\", \"5%\", \"15%\"."
            },
            "unit": {
              "type": "string",
              "maxWords": 2,
              "note": "\"per transaction\"."
            },
            "secondaryFigure": {
              "type": "string",
              "maxWords": 1,
              "note": "lower (dashed) area second rate, /pricing/ column 1"
            },
            "secondaryUnit": {
              "type": "string",
              "maxWords": 2
            },
            "checklist": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "string",
                "maxWords": 7
              }
            }
          }
        }
      },
      "headline": {
        "type": "string",
        "maxWords": 6,
        "note": "Custom tier heading, measured 6 words."
      },
      "body": {
        "type": "string",
        "maxWords": 18,
        "note": "BODY COPY b (real saved copy on /pricing/, /product/coda-links/, /product/distribution/); level c on webstore/codapay. Budget from measured 12-18."
      },
      "checklist": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string",
          "maxWords": 3,
          "note": "Measured 2-3 word items in the custom tier."
        }
      },
      "button": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "style"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxWords": 2
          },
          "style": {
            "type": "string",
            "enum": [
              "black",
              "grey"
            ]
          }
        }
      }
    }
  },
  "variants": {
    "standard-full": "/pricing/: two rate columns + checklist",
    "standard-single": "links/codapay/webstore: one rate column (1%)",
    "standard-flat": "distribution: flat 15% + checklist",
    "custom": "always: heading, body, three 2-3 word checklist items, contact button"
  },
  "tokens": [
