{
  "id": "component.card-product",
  "kind": "component",
  "purpose": "Homepage product tile: charcoal rounded panel with a background photo, corner arrow, product icon+wordmark, one short line, and a hover-driven media (marquee, replace or lift).",
  "props": {
    "additionalProperties": false,
    "required": [
      "href",
      "background",
      "icon",
      "description",
      "media"
    ],
    "properties": {
      "href": {
        "type": "string",
        "enum": [
          "/product/coda-consumer-platforms/",
          "/product/codapay/",
          "/product/coda-links/",
          "/product/coda-webstore/",
          "/product/distribution/"
        ]
      },
      "wide": {
        "type": "boolean",
        "note": "md:col-span-2 (3 of 5 cards on the homepage)"
      },
      "background": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "assetRef"
        ],
        "properties": {
          "assetRole": {
            "type": "string",
            "enum": [
              "product-card-mockup"
            ]
          },
          "assetRef": {
            "type": "string",
            "format": "local-asset-path"
          }
        }
      },
      "icon": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "glyph"
        ],
        "properties": {
          "glyph": {
            "type": "string",
            "enum": [
              "inline-svg-glyph"
            ]
          },
          "wordmark": {
            "type": "string",
            "enum": [
              "inline-svg-wordmark"
            ]
          }
        }
      },
      "description": {
        "type": "string",
        "maxWords": 20,
        "note": "BODY COPY: homepage exact (a) 12-20 words; budget 20."
      },
      "media": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "behaviour",
          "assetRole"
        ],
        "properties": {
          "behaviour": {
            "type": "string",
            "enum": [
              "marquee",
              "hover-up",
              "hover-replace"
            ]
          },
          "assetRole": {
            "type": "string",
            "enum": [
              "product-card-mockup"
            ]
          },
          "assetRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "local-asset-path"
            }
          }
        }
      }
    }
  },
  "variants": {
    "marquee": "consumer-platforms card (3 phone shots, two wrappers per breakpoint)",
    "hover-up": "codapay card (image lifts 8px)",
    "hover-replace": "links / webstore / distribution (base -> hover image crossfade, desktop only)"
  },
  "tokens": [
