  "motion": {
    "pattern": "reveal-stagger",
    "duration": "motion.reveal.duration",
    "easing": "motion.reveal.easing",
    "delayStep": "motion.reveal.stagger-step",
    "reducedMotionFallback": "Design rule: drop hover crossfade/lift/radius growth; show the base state only.",
    "hover": "radius md -> xlu; media crossfade 200ms (desktop only); arrow corner icon line fades in 300ms"
